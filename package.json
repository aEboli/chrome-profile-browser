{
  "name": "chrome-profile-browser",
  "version": "0.1.134",
  "appVersion": "0.1.134",
  "private": true,
  "author": "aEboli",
  "description": "本地优先的 Chromium profile 与代理节点工作台",
  "main": "src/main/main.js",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "check": "node scripts/check.js",
    "version:patch": "node scripts/bump-version.js patch",
    "version:feature": "node scripts/bump-version.js feature",
    "version:minor": "node scripts/bump-version.js minor",
    "version:major": "node scripts/bump-version.js major",
    "version:check": "node scripts/bump-version.js --check",
    "dist:dir": "electron-builder --dir --win --x64",
    "dist:win": "electron-builder --win --x64",
    "dist:mac": "electron-builder --mac",
    "dist:mac:x64": "electron-builder --mac --x64",
    "dist:mac:arm64": "electron-builder --mac --arm64"
  },
  "dependencies": {
    "qrcode": "^1.5.4",
    "undici": "^7.29.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "electron": "44.4.3",
    "electron-builder": "26.15.3"
  }
}
